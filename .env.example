# SQLite (padrão para desenvolvimento; uma chave temporária é gerada se SECRET_KEY ficar vazia):
DATABASE_URL=sqlite:///./safewalk.db
APP_ENV=development
# Em produção, configure uma chave aleatória persistente com pelo menos 32 caracteres.
SECRET_KEY=
ACCESS_TOKEN_MINUTES=120
# Vazio usa true em desenvolvimento e false em produção.
SEED_DEMO_USERS=
# Para Docker Compose, defina uma senha URL-safe aleatória antes de subir o banco.
POSTGRES_PASSWORD=
POSTGRES_USER=safewalk
POSTGRES_DB=safewalk
